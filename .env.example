# Database (Supabase — use session pooler URL, not direct connection)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres"

# NextAuth v5
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (customers)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (magic link for customers + transactional via Resend SMTP)
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD=""   # Resend API key
EMAIL_FROM="Railside Rides <hello@railsiderides.com>"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Twilio (SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM="+1XXXXXXXXXX"

# Resend (transactional email)
RESEND_API_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Blob (gallery photo uploads)
BLOB_READ_WRITE_TOKEN=""   # Vercel project → Storage → Blob → your store → token

# Cron security
CRON_SECRET="generate-with-openssl-rand-base64-32"
