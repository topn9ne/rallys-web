generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum MemberTier {
  MEMBER
  TEAM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  NONE
}

enum Lane {
  A
  B
}

enum CageSlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum BookingType {
  SINGLE_LANE
  BOTH_LANES
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum WaiverStatus {
  PENDING
  SIGNED
}

enum AccessCodeType {
  TIME_BOUND
}

enum AccessCodeStatus {
  SETTING
  ACTIVE
  EXPIRED
  REVOKED
}

enum PricingTier {
  MEMBER
  TEAM
  DROPIN_SINGLE
  DROPIN_BOTH
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Member {
  id                    String             @id @default(uuid())
  name                  String
  email                 String             @unique
  phone                 String
  tier                  MemberTier         @default(MEMBER)
  stripeCustomerId      String?            @unique
  stripeSubscriptionId  String?
  subscriptionStatus    SubscriptionStatus @default(NONE)
  notificationSms       Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  bookings Booking[]
  waivers  Waiver[]

  @@map("members")
}

model CageSlot {
  id          String         @id @default(uuid())
  lane        Lane
  date        DateTime       @db.Date
  startTime   DateTime
  endTime     DateTime
  status      CageSlotStatus @default(AVAILABLE)
  blockReason String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  bookingsA Booking[] @relation("SlotA")
  bookingsB Booking[] @relation("SlotB")

  @@map("cage_slots")
}

model Booking {
  id                    String        @id @default(uuid())
  memberId              String?
  guestName             String?
  guestEmail            String?
  guestPhone            String?
  bookingType           BookingType
  slotIdA               String
  slotIdB               String?
  status                BookingStatus @default(PENDING)
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?
  baseAmountCents       Int           @default(0)
  totalAmountCents      Int           @default(0)
  taxAmountCents        Int           @default(0)
  notes                 String?
  reminderSent          Boolean       @default(false)
  accessCodeId          String?
  accessCodePin         String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  member     Member?      @relation(fields: [memberId], references: [id])
  slotA      CageSlot     @relation("SlotA", fields: [slotIdA], references: [id])
  slotB      CageSlot?    @relation("SlotB", fields: [slotIdB], references: [id])
  waiver     Waiver?
  accessCode AccessCode?

  @@map("bookings")
}

model Waiver {
  id                    String       @id @default(uuid())
  memberId              String?
  bookingId             String?      @unique
  signerName            String
  signedAt              DateTime?
  ipAddress             String?
  agreementTextSnapshot String       @db.Text
  isMinor               Boolean      @default(false)
  guardianName          String?
  status                WaiverStatus @default(PENDING)
  createdAt             DateTime     @default(now())

  member  Member?  @relation(fields: [memberId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@map("waivers")
}

model AccessCode {
  id               String           @id @default(uuid())
  seamAccessCodeId String           @unique
  pin              String
  bookingId        String           @unique
  type             AccessCodeType   @default(TIME_BOUND)
  startsAt         DateTime
  endsAt           DateTime
  status           AccessCodeStatus @default(SETTING)
  createdAt        DateTime         @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("access_codes")
}

model PricingConfig {
  id             String      @id @default(uuid())
  tier           PricingTier
  amountCents    Int
  taxRatePercent Float       @default(0)
  effectiveFrom  DateTime    @default(now())
  createdAt      DateTime    @default(now())

  @@map("pricing_configs")
}

model OperatingHours {
  id        String  @id @default(uuid())
  dayOfWeek Int
  openTime  String
  closeTime String
  isOpen    Boolean @default(true)

  @@map("operating_hours")
}

model WaiverTemplate {
  id        String   @id @default(uuid())
  body      String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("waiver_templates")
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
