generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum MemberTier {
  FAMILY
  TEAM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  NONE
}

enum Lane {
  A
  B
}

enum CageSlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
  COMPLETED
}

enum BookingType {
  SINGLE_LANE
  BOTH_LANES
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum WaiverStatus {
  PENDING
  SIGNED
}

enum AccessCodeType {
  TIME_BOUND
}

enum AccessCodeStatus {
  SETTING
  ACTIVE
  EXPIRED
  REVOKED
}

enum PricingTier {
  FAMILY
  FAMILY_ANNUAL
  TEAM
  TEAM_ANNUAL
  DROPIN_SINGLE
  DROPIN_BOTH
}

enum DiscountType {
  PERCENT
  FIXED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Member {
  id                    String             @id @default(uuid())
  name                  String
  email                 String             @unique
  phone                 String
  tier                  MemberTier         @default(FAMILY)
  stripeCustomerId      String?            @unique
  stripeSubscriptionId  String?
  subscriptionStatus    SubscriptionStatus @default(NONE)
  notificationSms       Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  bookings             Booking[]
  waivers              Waiver[]
  players              Player[]
  notificationContacts NotificationContact[]

  @@map("members")
}

model Player {
  id          String   @id @default(uuid())
  memberId    String
  name        String
  dateOfBirth DateTime? @db.Date
  positions   String?
  school      String?
  travelTeam  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  member          Member             @relation(fields: [memberId], references: [id])
  bookingPlayers  BookingPlayer[]
  hours           PlayerHours?
  summerStats     PlayerSummerStats[]
  milestones      PlayerMilestones[]

  @@map("players")
}

model CageSlot {
  id          String         @id @default(uuid())
  lane        Lane
  date        DateTime       @db.Date
  startTime   DateTime
  endTime     DateTime
  status      CageSlotStatus @default(AVAILABLE)
  blockReason String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  bookingsA Booking[] @relation("SlotA")
  bookingsB Booking[] @relation("SlotB")

  @@map("cage_slots")
}

model Booking {
  id                    String        @id @default(uuid())
  memberId              String?
  guestName             String?
  guestEmail            String?
  guestPhone            String?
  bookingType           BookingType
  slotIdA               String
  slotIdB               String?
  status                BookingStatus @default(PENDING)
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?
  baseAmountCents       Int           @default(0)
  totalAmountCents      Int           @default(0)
  taxAmountCents        Int           @default(0)
  discountAmountCents   Int           @default(0)
  promoCodeId           String?
  notes                 String?
  reminderSent          Boolean       @default(false)
  accessCodeId          String?
  accessCodePin         String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  member     Member?         @relation(fields: [memberId], references: [id])
  slotA      CageSlot        @relation("SlotA", fields: [slotIdA], references: [id])
  slotB      CageSlot?       @relation("SlotB", fields: [slotIdB], references: [id])
  waiver     Waiver?
  accessCode AccessCode?
  promoCode  PromoCode?      @relation(fields: [promoCodeId], references: [id])
  players    BookingPlayer[]

  @@map("bookings")
}

model BookingPlayer {
  bookingId String
  playerId  String

  booking Booking @relation(fields: [bookingId], references: [id])
  player  Player  @relation(fields: [playerId], references: [id])

  @@id([bookingId, playerId])
  @@map("booking_players")
}

model Waiver {
  id                    String       @id @default(uuid())
  memberId              String?
  bookingId             String?      @unique
  signerName            String
  signedAt              DateTime?
  ipAddress             String?
  agreementTextSnapshot String       @db.Text
  isMinor               Boolean      @default(false)
  guardianName          String?
  participants          Json?
  status                WaiverStatus @default(PENDING)
  createdAt             DateTime     @default(now())

  member  Member?  @relation(fields: [memberId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@map("waivers")
}

model AccessCode {
  id               String           @id @default(uuid())
  seamAccessCodeId String           @unique
  pin              String
  bookingId        String           @unique
  type             AccessCodeType   @default(TIME_BOUND)
  startsAt         DateTime
  endsAt           DateTime
  status           AccessCodeStatus @default(SETTING)
  createdAt        DateTime         @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("access_codes")
}

model PromoCode {
  id             String       @id @default(uuid())
  code           String       @unique
  description    String?
  discountType   DiscountType
  discountAmount Int
  maxUses        Int?
  currentUses    Int          @default(0)
  validFrom      DateTime?
  validUntil     DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  bookings Booking[]

  @@map("promo_codes")
}

model PricingConfig {
  id             String      @id @default(uuid())
  tier           PricingTier
  amountCents    Int
  taxRatePercent Float       @default(0)
  effectiveFrom  DateTime    @default(now())
  createdAt      DateTime    @default(now())

  @@map("pricing_configs")
}

model OperatingHours {
  id        String  @id @default(uuid())
  dayOfWeek Int
  openTime  String
  closeTime String
  isOpen    Boolean @default(true)

  @@map("operating_hours")
}

model WaiverTemplate {
  id               String    @id @default(uuid())
  body             String    @db.Text
  updatedAt        DateTime  @updatedAt
  resignRequiredAt DateTime?

  @@map("waiver_templates")
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ─── Cage Rats Tracking ───────────────────────────────────────────────────────

model PlayerHours {
  id            String    @id @default(uuid())
  playerId      String    @unique
  totalMinutes  Int       @default(0)
  lastSessionAt DateTime?
  updatedAt     DateTime  @updatedAt

  player Player @relation(fields: [playerId], references: [id])

  @@map("player_hours")
}

model PlayerSummerStats {
  id            String   @id @default(uuid())
  playerId      String
  year          Int
  summerMinutes Int      @default(0)
  qualified     Boolean  @default(false)
  shirtAwarded  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, year])
  @@map("player_summer_stats")
}

model PlayerMilestones {
  id           String   @id @default(uuid())
  playerId     String
  milestoneKey String
  achievedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, milestoneKey])
  @@map("player_milestones")
}

model NotificationContact {
  id           String   @id @default(uuid())
  memberId     String
  name         String
  phone        String?
  email        String?
  relationship String
  sendCodes    Boolean  @default(true)
  sendBookings Boolean  @default(true)
  sendBilling  Boolean  @default(false)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id])

  @@map("notification_contacts")
}

model Waitlist {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("waitlist")
}
